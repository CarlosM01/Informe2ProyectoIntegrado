{
  "_descripcion": "SGP-Kotoduo — Base de datos no estructurada (MongoDB 8, base 'sgp_docs'). Anexo C del Informe N.º 2, sección 6.4. Cada entrada define el validador $jsonSchema, los índices y un documento de ejemplo de la colección.",
  "colecciones": {
    "bitacora_eventos": {
      "proposito": "Auditoría inmutable de acciones (RF-12). Se alimenta desde outbox_evento de PostgreSQL; el _id es 'evt-<outbox_evento.id>', lo que hace la escritura idempotente.",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": ["_id", "ts", "tipo", "agregado", "actor", "payload"],
          "additionalProperties": false,
          "properties": {
            "_id": { "bsonType": "string", "pattern": "^evt-[0-9]+$" },
            "ts": { "bsonType": "date" },
            "tipo": {
              "enum": ["ORDEN_REGISTRADA", "ORDEN_ESTADO_CAMBIADO", "ETAPA_ASIGNADA", "ETAPA_INICIADA",
                       "ETAPA_TERMINADA", "ETAPA_BLOQUEADA", "DISENO_SUBIDO", "DISENO_RESUELTO",
                       "INSUMO_MOVIMIENTO", "ALERTA_INSUMO_CREADA", "ALERTA_INSUMO_CERRADA",
                       "USUARIO_CREADO", "USUARIO_ROL_CAMBIADO", "LOGIN_EXITOSO", "LOGIN_FALLIDO",
                       "CUENTA_BLOQUEADA", "SESIONES_REVOCADAS"]
            },
            "agregado": {
              "bsonType": "object",
              "required": ["tipo", "id"],
              "additionalProperties": false,
              "properties": {
                "tipo": { "enum": ["orden_trabajo", "etapa_orden", "insumo", "alerta_insumo", "aprobacion_diseno", "usuario"] },
                "id": { "bsonType": "string", "maxLength": 40 }
              }
            },
            "orden_id": { "bsonType": ["string", "null"], "maxLength": 36 },
            "actor": {
              "bsonType": "object",
              "required": ["usuario_id", "roles"],
              "additionalProperties": false,
              "properties": {
                "usuario_id": { "bsonType": ["string", "null"], "maxLength": 36 },
                "roles": { "bsonType": "array", "items": { "bsonType": "string" } },
                "ip": { "bsonType": "string", "maxLength": 45 }
              }
            },
            "payload": { "bsonType": "object" },
            "request_id": { "bsonType": "string", "maxLength": 36 }
          }
        }
      },
      "indices": [
        { "key": { "orden_id": 1, "ts": -1 }, "name": "ix_orden_ts" },
        { "key": { "actor.usuario_id": 1, "ts": -1 }, "name": "ix_actor_ts" },
        { "key": { "tipo": 1, "ts": -1 }, "name": "ix_tipo_ts" },
        { "key": { "ts": 1 }, "name": "ttl_24_meses", "expireAfterSeconds": 63072000 }
      ],
      "privilegios_app": "Rol personalizado 'sgpAuditWriter': solo find + insert (sin update/remove) sobre esta colección.",
      "ejemplo": {
        "_id": "evt-1842",
        "ts": { "$date": "2026-11-24T14:32:10.120Z" },
        "tipo": "ETAPA_TERMINADA",
        "agregado": { "tipo": "etapa_orden", "id": "891b7e01-85bc-42ef-9c23-25b9396704f0" },
        "orden_id": "10000000-0000-0000-0000-000000000001",
        "actor": { "usuario_id": "00000000-0000-0000-0000-000000000002", "roles": ["OPERARIO"], "ip": "190.22.10.5" },
        "payload": { "estado_anterior": "EN_CURSO", "estado_nuevo": "TERMINADA", "siguiente_etapa": "Sublimado", "siguiente_area": "Sublimación" },
        "request_id": "5f0c2a8e-7b1d-4c39-9a51-0d1e2f3a4b5c"
      }
    },

    "evidencias_etapa": {
      "proposito": "Evidencias del trabajo (RF-07) y versiones de diseño (RF-08): fotos, notas y metadatos de archivos. El binario se guarda en Cloudflare R2; aquí quedan la referencia, el hash y los metadatos variables, que dependen del tipo de trabajo.",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": ["orden_id", "tipo", "creado_por", "creado_en"],
          "properties": {
            "orden_id": { "bsonType": "string", "maxLength": 36 },
            "etapa_orden_id": { "bsonType": ["string", "null"], "maxLength": 36 },
            "tipo": { "enum": ["FOTO", "NOTA", "DISENO", "DOCUMENTO"] },
            "nota": { "bsonType": "string", "maxLength": 2000 },
            "archivo": {
              "bsonType": "object",
              "required": ["object_key", "mime", "bytes", "sha256"],
              "additionalProperties": false,
              "properties": {
                "object_key": { "bsonType": "string", "pattern": "^evidencias/[0-9a-f-]{36}/[0-9a-f-]{36}\\.(jpg|png|webp|pdf)$" },
                "mime": { "enum": ["image/jpeg", "image/png", "image/webp", "application/pdf"] },
                "bytes": { "bsonType": ["int", "long"], "minimum": 1, "maximum": 10485760 },
                "sha256": { "bsonType": "string", "pattern": "^[0-9a-f]{64}$" },
                "ancho_px": { "bsonType": "int" },
                "alto_px": { "bsonType": "int" }
              }
            },
            "metadatos": { "bsonType": "object", "description": "Campos libres según el tipo de trabajo (medidas, tallas, perfil de color, ubicación de instalación)" },
            "etiquetas": { "bsonType": "array", "items": { "bsonType": "string", "maxLength": 30 }, "maxItems": 10 },
            "creado_por": { "bsonType": "string", "maxLength": 36 },
            "creado_en": { "bsonType": "date" }
          },
          "anyOf": [
            { "required": ["nota"] },
            { "required": ["archivo"] }
          ]
        }
      },
      "indices": [
        { "key": { "orden_id": 1, "creado_en": -1 }, "name": "ix_orden_fecha" },
        { "key": { "etapa_orden_id": 1 }, "name": "ix_etapa" },
        { "key": { "archivo.sha256": 1 }, "name": "ix_hash", "sparse": true }
      ],
      "ejemplo": {
        "_id": { "$oid": "6740a1f2c3d4e5f601234567" },
        "orden_id": "10000000-0000-0000-0000-000000000001",
        "etapa_orden_id": "891b7e01-85bc-42ef-9c23-25b9396704f0",
        "tipo": "DISENO",
        "nota": "Versión 2: se ajusta el escudo según la observación del cliente.",
        "archivo": {
          "object_key": "evidencias/10000000-0000-0000-0000-000000000001/2b7c9e4a-1f3d-4a6b-8c2e-9d0f1a2b3c4d.png",
          "mime": "image/png",
          "bytes": 482113,
          "sha256": "9f2c1e0b7a6d5c4b3a291807f6e5d4c3b2a1908f7e6d5c4b3a2918070f6e5d4c",
          "ancho_px": 2400,
          "alto_px": 1600
        },
        "metadatos": { "perfil_color": "sRGB", "tallas": { "S": 5, "M": 15, "L": 10 } },
        "etiquetas": ["diseno", "v2"],
        "creado_por": "00000000-0000-0000-0000-000000000004",
        "creado_en": { "$date": "2026-11-23T18:05:00Z" }
      }
    },

    "notificaciones": {
      "proposito": "Bandeja de avisos in-app y registro del envío Web Push (RF-06, RF-10). Expira a los 90 días.",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": ["_id", "destinatario_id", "tipo", "titulo", "leida", "creada_en"],
          "additionalProperties": false,
          "properties": {
            "_id": { "bsonType": "string", "description": "'ntf-<outbox_id>-<destinatario>' para idempotencia" },
            "destinatario_id": { "bsonType": "string", "maxLength": 36 },
            "tipo": { "enum": ["ETAPA_DISPONIBLE", "ALERTA_INSUMO", "DISENO_PENDIENTE", "DISENO_RECHAZADO", "ORDEN_EN_RIESGO"] },
            "titulo": { "bsonType": "string", "maxLength": 120 },
            "cuerpo": { "bsonType": "string", "maxLength": 500 },
            "enlace": { "bsonType": "string", "pattern": "^/[a-z0-9/_-]*$" },
            "leida": { "bsonType": "bool" },
            "push": {
              "bsonType": "object",
              "properties": {
                "enviado": { "bsonType": "bool" },
                "intentos": { "bsonType": "int" },
                "ultimo_error": { "bsonType": ["string", "null"] }
              }
            },
            "creada_en": { "bsonType": "date" }
          }
        }
      },
      "indices": [
        { "key": { "destinatario_id": 1, "leida": 1, "creada_en": -1 }, "name": "ix_bandeja" },
        { "key": { "creada_en": 1 }, "name": "ttl_90_dias", "expireAfterSeconds": 7776000 }
      ],
      "ejemplo": {
        "_id": "ntf-1842-00000000-0000-0000-0000-000000000002",
        "destinatario_id": "00000000-0000-0000-0000-000000000002",
        "tipo": "ETAPA_DISPONIBLE",
        "titulo": "OT-2026-0001: Sublimado disponible",
        "cuerpo": "La etapa anterior fue terminada. Puedes iniciar 'Sublimado' en el área Sublimación.",
        "enlace": "/ordenes/ot-2026-0001",
        "leida": false,
        "push": { "enviado": true, "intentos": 1, "ultimo_error": null },
        "creada_en": { "$date": "2026-11-24T14:32:11Z" }
      }
    }
  }
}
