@startuml
' Figura 4.20 — Casos de uso: actores, acceso y administración
!include ../_comun/estilo.iuml
skinparam actorStyle awesome
left to right direction

actor "Operario" as OP
actor "Diseñador" as DI
actor "Vendedor" as VE
actor "Encargada de\nProducción" as EP
actor "Administrador" as AD
actor "Usuario\nautenticado" as U

OP --|> U
DI --|> U
VE --|> U
EP --|> U
AD --|> EP

rectangle "SGP-Kotoduo — Acceso y administración" {
  usecase "CU-01 Iniciar sesión\n(con MFA si corresponde)" as CU01
  usecase "CU-02 Gestionar\nusuarios y roles" as CU02
  usecase "CU-11 Consultar bitácora\nde auditoría" as CU11
}

U --> CU01
AD --> CU02
AD --> CU11
@enduml
