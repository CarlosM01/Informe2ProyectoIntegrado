@startuml
' Figura 4.1 — Vista general de capas (monolito modular con cliente PWA)
!include ../_comun/estilo.iuml
left to right direction

actor "Trabajadores\n(móvil y PC)" as US
component "PWA React\n(SPA instalable)" as PWA
node "Cloudflare\nTLS 1.3 · WAF · rate limit" as CF

package "API Express — monolito modular" as API {
  component "Middleware\nde seguridad" as MW
  component "Módulos M1–M8\nroutes → controller →\nservice → repository" as MOD
  component "Relay outbox\ny planificador" as JOB
}

database "PostgreSQL\ndatos transaccionales\n+ outbox" as PG
database "MongoDB\nbitácora, evidencias,\nnotificaciones" as MG
cloud "Cloudflare R2\narchivos" as R2
cloud "Web Push\navisos" as WP

US --> PWA
PWA --> CF : HTTPS / JSON
CF --> MW
MW --> MOD
MOD --> PG : SQL (ACID)
JOB --> PG : lee outbox
JOB --> MG : publica eventos
JOB --> WP
PWA --> R2 : URL prefirmada
@enduml
