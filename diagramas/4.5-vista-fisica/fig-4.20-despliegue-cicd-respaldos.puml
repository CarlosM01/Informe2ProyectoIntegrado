@startuml
' Figura 4.20 — Despliegue: integración continua, entrega y respaldos
!include ../_comun/estilo.iuml
left to right direction

cloud "GitHub" as GH {
  node "Repositorio\nsgp-kotoduo" as REPO
  node "GitHub Actions\n(CI/CD + cron 03:00 CLT)" as GHA
}

cloud "Cloudflare" as CF {
  node "Cloudflare Pages" as PAGES
  node "Cloudflare R2" as R2 {
    artifact "bucket sgp-respaldos\n(pg_dump cifrado con age)" as BKP
  }
}
cloud "Render" as RENDER {
  node "Web Service\n<<contenedor Docker>>" as WS
}
cloud "Neon" as NEON {
  database "PostgreSQL 16" as PGDB
}

REPO --> GHA : push / PR
GHA --> PAGES : despliega web\n(tras CI verde)
GHA --> WS : deploy hook\n(aprobación manual)
GHA --> PGDB : pg_dump diario
GHA --> BKP : sube respaldo\ncifrado
@enduml
