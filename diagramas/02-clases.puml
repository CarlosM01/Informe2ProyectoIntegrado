@startuml 02-clases
' Vista lógica (4+1) — Figura 4.2: modelo de dominio y servicios
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F3A5F
  ArrowColor #1F3A5F
}
hide empty members

package "Dominio" {
  enum EstadoOrden {
    REGISTRADA
    EN_DISENO
    EN_PRODUCCION
    DETENIDA
    TERMINADA
    ENTREGADA
    ANULADA
  }
  enum EstadoEtapa {
    PENDIENTE
    DISPONIBLE
    EN_CURSO
    BLOQUEADA
    TERMINADA
    OMITIDA
  }
  enum CodigoRol {
    ADMINISTRADOR
    ENCARGADA_PRODUCCION
    VENDEDOR
    DISENADOR
    OPERARIO
  }

  class Usuario {
    - id : UUID
    - nombreUsuario : String
    - nombreCompleto : String
    - passwordHash : String
    - mfaHabilitado : Boolean
    - activo : Boolean
    - intentosFallidos : int
    - bloqueadoHasta : DateTime
    + estaBloqueado(ahora : DateTime) : Boolean
    + tienePermiso(p : Permiso) : Boolean
  }
  class Rol {
    - id : int
    - codigo : CodigoRol
    - nombre : String
  }
  class Area {
    - id : int
    - nombre : String
    - activa : Boolean
  }
  class TipoTrabajo {
    - id : int
    - nombre : String
    - requiereDiseno : Boolean
    - version : int
  }
  class PlantillaEtapa {
    - secuencia : int
    - nombre : String
    - instrucciones : String
    - duracionEstimadaHoras : Decimal
    - esEtapaDiseno : Boolean
  }
  class OrdenTrabajo {
    - id : UUID
    - codigo : String
    - titulo : String
    - referenciaCliente : String
    - cantidad : int
    - especificaciones : JSON
    - prioridad : Prioridad
    - estado : EstadoOrden
    - fechaCompromiso : Date
    - fechaEstimadaTermino : Date
    + generarEtapas(t : TipoTrabajo) : List<EtapaOrden>
    + etapaActual() : EtapaOrden
    + calcularFechaEstimada(jornadaHoras : int) : Date
    + porcentajeAvance() : int
  }
  class EtapaOrden {
    - id : UUID
    - secuencia : int
    - nombre : String
    - instrucciones : String
    - estado : EstadoEtapa
    - motivoBloqueo : String
    - iniciadaEn : DateTime
    - terminadaEn : DateTime
    - version : int
    + iniciar(u : Usuario) : void
    + terminar(u : Usuario) : void
    + bloquear(motivo : String) : void
    + puedeTransicionar(destino : EstadoEtapa) : Boolean
  }
  class Insumo {
    - id : int
    - codigo : String
    - nombre : String
    - unidadMedida : UnidadMedida
    - stockActual : Decimal
    - stockMinimo : Decimal
    + estaBajoMinimo() : Boolean
  }
  class PlantillaInsumo {
    - cantidadPorUnidad : Decimal
  }
  class RequerimientoInsumo {
    - cantidadRequerida : Decimal
    - cantidadConsumida : Decimal
    + pendiente() : Decimal
  }
  class MovimientoInsumo {
    - tipo : TipoMovimiento
    - cantidad : Decimal
    - creadoEn : DateTime
  }
  class AlertaInsumo {
    - origen : OrigenAlerta
    - estado : EstadoAlerta
    - cantidadFaltante : Decimal
    + cerrar(u : Usuario) : void
  }
  class AprobacionDiseno {
    - version : int
    - evidenciaRef : String
    - estado : EstadoAprobacion
    - comentario : String
    + aprobar(u : Usuario) : void
    + rechazar(u : Usuario, motivo : String) : void
  }
}

package "Servicios de aplicación" {
  class AuthService {
    + login(usuario, clave) : ResultadoLogin
    + verificarMfa(desafio, codigo) : Tokens
    + refrescar(refreshToken) : Tokens
    + cerrarSesion(refreshToken) : void
  }
  class OrdenService {
    + registrar(dto : NuevaOrdenDTO, actor : Usuario) : OrdenTrabajo
    + asignarResponsable(etapaId, usuarioId, actor) : void
  }
  class EtapaService {
    + iniciar(etapaId, actor) : EtapaOrden
    + terminar(etapaId, version, consumos, actor) : ResultadoAvance
    + bloquear(etapaId, motivo, actor) : void
  }
  class InsumoService {
    + registrarMovimiento(dto, actor) : MovimientoInsumo
    + reportarFaltante(dto, actor) : AlertaInsumo
    + faltantesProyectados() : List<FaltanteDTO>
  }
  class DisenoService {
    + subirVersion(ordenId, evidencia, actor) : AprobacionDiseno
    + resolver(aprobacionId, decision, actor) : void
  }
  class AuditoriaService {
    + registrarEnOutbox(tx, evento : EventoDominio) : void
  }
  class NotificacionService {
    + notificar(destinatarios, aviso) : void
  }
}

Usuario "*" -- "1..*" Rol : posee >
Usuario "*" --> "0..1" Area : pertenece >
TipoTrabajo "1" *-- "1..*" PlantillaEtapa : define >
PlantillaEtapa "*" --> "1" Area : se ejecuta en >
PlantillaEtapa "1" *-- "*" PlantillaInsumo
PlantillaInsumo "*" --> "1" Insumo
OrdenTrabajo "*" --> "1" TipoTrabajo : instancia >
OrdenTrabajo "1" *-- "1..*" EtapaOrden : compuesta por >
OrdenTrabajo "*" --> "1" Usuario : creadoPor >
EtapaOrden "*" --> "1" Area
EtapaOrden "*" --> "0..1" Usuario : responsable >
EtapaOrden "*" ..> "0..1" PlantillaEtapa : origen >
EtapaOrden "1" *-- "*" RequerimientoInsumo
RequerimientoInsumo "*" --> "1" Insumo
Insumo "1" o-- "*" MovimientoInsumo : kardex >
Insumo "1" o-- "*" AlertaInsumo
AlertaInsumo "*" --> "0..1" EtapaOrden : bloquea >
OrdenTrabajo "1" *-- "*" AprobacionDiseno : versiones >
OrdenTrabajo --> EstadoOrden
EtapaOrden --> EstadoEtapa
Rol --> CodigoRol

OrdenService ..> OrdenTrabajo
OrdenService ..> AuditoriaService
EtapaService ..> EtapaOrden
EtapaService ..> InsumoService
EtapaService ..> AuditoriaService
InsumoService ..> Insumo
DisenoService ..> AprobacionDiseno
AuditoriaService ..> NotificacionService : relay outbox
AuthService ..> Usuario
@enduml
