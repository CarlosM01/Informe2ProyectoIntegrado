@startuml
' Figura 4.7 — Máquina de estados de EtapaOrden
' (implementada en EtapaOrden.puedeTransicionar() y en el trigger trg_etapa_transicion)
!include ../_comun/estilo.iuml
hide empty description
left to right direction

state "Abierta" as Abierta {
  [*] --> PENDIENTE : orden registrada\n(etapas generadas)
  PENDIENTE --> DISPONIBLE : etapa anterior cerrada\n[TERMINADA u OMITIDA,\no es la primera]
  DISPONIBLE --> EN_CURSO : responsable "Iniciar"\n[OT no DETENIDA]
  EN_CURSO --> BLOQUEADA : "Reportar problema"\n[motivo obligatorio]\n/ notifica a la Encargada;\ndetiene la OT
  BLOQUEADA --> EN_CURSO : Encargada "Desbloquear"\n/ motivo_bloqueo := NULL
}

EN_CURSO --> TERMINADA : responsable "Terminar"\n[OT no DETENIDA y\nno es etapa de diseño]\n/ habilita siguiente etapa
EN_CURSO --> TERMINADA : diseño APROBADO\n[etapa de diseño]\n/ habilita siguiente etapa
PENDIENTE --> OMITIDA : Encargada "Omitir"\n[no aplica al trabajo]
DISPONIBLE --> OMITIDA : Encargada "Omitir"\n/ habilita siguiente etapa
Abierta --> OMITIDA : OT anulada
TERMINADA --> [*]
OMITIDA --> [*]
@enduml
