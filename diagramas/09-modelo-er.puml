@startuml 09-modelo-er
' Modelo de datos — Figura 6.1: Modelo entidad-relación (notación IE / pata de gallo)
hide circle
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F3A5F
}

entity "rol" as rol {
  * id : SMALLSERIAL <<PK>>
  --
  * codigo : VARCHAR(30) <<UK>>
  * nombre : VARCHAR(60)
  descripcion : VARCHAR(255)
}
entity "area" as area {
  * id : SMALLSERIAL <<PK>>
  --
  * nombre : VARCHAR(60) <<UK>>
  * activa : BOOLEAN
}
entity "usuario" as usuario {
  * id : UUID <<PK>>
  --
  * nombre_usuario : VARCHAR(40) <<UK>>
  * nombre_completo : VARCHAR(100)
  correo : VARCHAR(120) <<UK>>
  * password_hash : TEXT
  * mfa_habilitado : BOOLEAN
  mfa_secreto_cifrado : BYTEA
  area_id : SMALLINT <<FK>>
  * activo : BOOLEAN
  * intentos_fallidos : SMALLINT
  bloqueado_hasta : TIMESTAMPTZ
}
entity "usuario_rol" as usuario_rol {
  * usuario_id : UUID <<PK,FK>>
  * rol_id : SMALLINT <<PK,FK>>
  --
  asignado_por : UUID <<FK>>
  * asignado_en : TIMESTAMPTZ
}
entity "sesion_refresh" as sesion {
  * id : UUID <<PK>>
  --
  * usuario_id : UUID <<FK>>
  * familia_id : UUID
  * token_hash : CHAR(64) <<UK>>
  * expira_en : TIMESTAMPTZ
  revocado_en : TIMESTAMPTZ
}
entity "tipo_trabajo" as tipo {
  * id : SMALLSERIAL <<PK>>
  --
  * nombre : VARCHAR(80) <<UK>>
  * requiere_diseno : BOOLEAN
  * version : INTEGER
}
entity "plantilla_etapa" as pe {
  * id : SERIAL <<PK>>
  --
  * tipo_trabajo_id : SMALLINT <<FK>>
  * secuencia : SMALLINT
  * nombre : VARCHAR(80)
  * area_id : SMALLINT <<FK>>
  * instrucciones : TEXT
  * duracion_estimada_horas : NUMERIC(5,1)
  * es_etapa_diseno : BOOLEAN
}
entity "insumo" as insumo {
  * id : SERIAL <<PK>>
  --
  * codigo : VARCHAR(20) <<UK>>
  * nombre : VARCHAR(80)
  * unidad_medida : VARCHAR(10)
  * stock_actual : NUMERIC(12,2)
  * stock_minimo : NUMERIC(12,2)
}
entity "plantilla_insumo" as pi {
  * plantilla_etapa_id : INTEGER <<PK,FK>>
  * insumo_id : INTEGER <<PK,FK>>
  --
  * cantidad_por_unidad : NUMERIC(10,3)
}
entity "orden_trabajo" as ot {
  * id : UUID <<PK>>
  --
  * codigo : VARCHAR(20) <<UK>>
  * tipo_trabajo_id : SMALLINT <<FK>>
  * titulo : VARCHAR(120)
  * referencia_cliente : VARCHAR(80)
  * cantidad : INTEGER
  * especificaciones : JSONB
  * prioridad : VARCHAR(10)
  * estado : VARCHAR(20)
  * fecha_compromiso : DATE
  fecha_estimada_termino : DATE
  * creado_por : UUID <<FK>>
}
entity "etapa_orden" as eo {
  * id : UUID <<PK>>
  --
  * orden_id : UUID <<FK>>
  plantilla_etapa_id : INTEGER <<FK>>
  * secuencia : SMALLINT
  * nombre : VARCHAR(80)
  * area_id : SMALLINT <<FK>>
  responsable_id : UUID <<FK>>
  * estado : VARCHAR(12)
  motivo_bloqueo : VARCHAR(255)
  iniciada_en / terminada_en : TIMESTAMPTZ
  * version : INTEGER
}
entity "requerimiento_insumo" as ri {
  * id : SERIAL <<PK>>
  --
  * etapa_orden_id : UUID <<FK>>
  * insumo_id : INTEGER <<FK>>
  * cantidad_requerida : NUMERIC(12,2)
  * cantidad_consumida : NUMERIC(12,2)
}
entity "movimiento_insumo" as mi {
  * id : BIGSERIAL <<PK>>
  --
  * insumo_id : INTEGER <<FK>>
  * tipo : VARCHAR(10)
  * cantidad : NUMERIC(12,2)
  etapa_orden_id : UUID <<FK>>
  * usuario_id : UUID <<FK>>
}
entity "alerta_insumo" as ai {
  * id : SERIAL <<PK>>
  --
  * insumo_id : INTEGER <<FK>>
  etapa_orden_id : UUID <<FK>>
  * origen : VARCHAR(10)
  * estado : VARCHAR(12)
  cantidad_faltante : NUMERIC(12,2)
  reportada_por : UUID <<FK>>
  cerrada_por : UUID <<FK>>
}
entity "aprobacion_diseno" as ad {
  * id : SERIAL <<PK>>
  --
  * orden_id : UUID <<FK>>
  * version : SMALLINT
  * evidencia_ref : CHAR(24)
  * estado : VARCHAR(10)
  * subido_por : UUID <<FK>>
  resuelto_por : UUID <<FK>>
  comentario : VARCHAR(500)
}
entity "outbox_evento" as ob {
  * id : BIGSERIAL <<PK>>
  --
  * tipo : VARCHAR(40)
  * agregado / agregado_id : VARCHAR
  actor_id : UUID <<FK>>
  * payload : JSONB
  procesado_en : TIMESTAMPTZ
}

usuario ||--o{ usuario_rol
rol ||--o{ usuario_rol
area |o--o{ usuario
usuario ||--o{ sesion
tipo ||--|{ pe
area ||--o{ pe
pe ||--o{ pi
insumo ||--o{ pi
tipo ||--o{ ot
usuario ||--o{ ot : crea
ot ||--|{ eo
pe |o..o{ eo : origen
area ||--o{ eo
usuario |o--o{ eo : responsable
eo ||--o{ ri
insumo ||--o{ ri
insumo ||--o{ mi
eo |o--o{ mi
usuario ||--o{ mi
insumo ||--o{ ai
eo |o--o{ ai
ot ||--o{ ad
usuario ||--o{ ad : sube/resuelve
usuario |o--o{ ob : actor
@enduml
